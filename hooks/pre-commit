#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR"

echo "pre-commit: bump minor version"
node scripts/bump-version.js
node scripts/sync-versions.js
git add package.json .agents/plugins/marketplace.json .codex-plugin/plugin.json .claude-plugin/plugin.json .claude-plugin/marketplace.json
if [[ -f package-lock.json ]]; then
  git add package-lock.json
fi

echo "pre-commit: lint"
npm run lint

echo "pre-commit: test"
npm test

echo "pre-commit: package dry-run"
npm pack --dry-run

echo "pre-commit: passed"
